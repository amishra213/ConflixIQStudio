# Netflix Conductor Configuration
# These variables are used as fallbacks when not specified in the UI

# Conductor Server URL (without /graphql suffix)
VITE_CONDUCTOR_SERVER_URL=http://localhost:8080

# Conductor GraphQL Endpoint (full URL including /graphql)
# Note: Your GraphQL endpoint is on port 4000, while Conductor server is on 8080
VITE_CONDUCTOR_GRAPHQL_URL=http://localhost:4000/graphql

# Conductor API Key (optional - leave empty if not using authentication)
VITE_CONDUCTOR_API_KEY=

# Application Configuration
VITE_APP_NAME=ConflixIQStudio
VITE_APP_VERSION=1.0.0

# Development Settings
VITE_DEV_PORT=5173
VITE_API_TIMEOUT=30000
VITE_RETRY_ATTEMPTS=3

# Logging Configuration
VITE_ENABLE_LOGGING=true
VITE_LOG_LEVEL=info
VITE_LOG_FOLDER=./logs

# Example for custom Conductor setup:
# VITE_CONDUCTOR_SERVER_URL=http://your-conductor-server:8080
# VITE_CONDUCTOR_GRAPHQL_URL=http://your-conductor-server:8080/graphql
# VITE_CONDUCTOR_API_KEY=your-api-key-here

# ─── LLM / AI Troubleshoot Configuration ────────────────────────────────────
# Supports any OpenAI-compatible API (OpenAI, DeepSeek, Azure OpenAI, Ollama, etc.)

# LLM API endpoint
# OpenAI:   https://api.openai.com/v1/chat/completions
# DeepSeek: https://api.deepseek.com/v1/chat/completions
# Azure:    https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2024-02-01
# Ollama:   http://localhost:11434/v1/chat/completions
VITE_LLM_API_ENDPOINT=https://api.deepseek.com/v1/chat/completions

# LLM API Key (required for hosted providers; leave empty for local Ollama)
VITE_LLM_API_KEY=sk-bb6eccba5fb9489e8fc77ec715113eec

# Model name to use for troubleshooting
# DeepSeek: deepseek-chat | deepseek-coder | deepseek-reasoner
# OpenAI:   gpt-4o | gpt-4-turbo | gpt-3.5-turbo
# Ollama:   llama3 | mistral | codellama
VITE_LLM_MODEL=deepseek-chat
